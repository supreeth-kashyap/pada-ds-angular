{
  "name": "pada-ds-angular",
  "version": "1.2.1",
  "description": "Singular design system for Angular applications, built with TypeScript and signals.",
  "license": "MIT",
  "author": "Supreeth Kashyap",
  "homepage": "https://github.com/supreeth-kashyap/pada-ds-angular#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/supreeth-kashyap/pada-ds-angular.git"
  },
  "bugs": {
    "url": "https://github.com/supreeth-kashyap/pada-ds-angular/issues"
  },
  "keywords": [
    "angular",
    "design-system",
    "components",
    "ui",
    "headless",
    "signals",
    "pada",
    "design-tokens"
  ],
  "peerDependencies": {
    "@angular/cdk": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.4",
    "tslib": "^2.3.0"
  },
  "exports": {
    "./tokens.css": {
      "style": "./styles/tokens.css",
      "default": "./styles/tokens.css"
    },
    "./styles.css": {
      "style": "./styles/styles.css",
      "default": "./styles/styles.css"
    },
    "./base.css": {
      "style": "./styles/base.css",
      "default": "./styles/base.css"
    },
    "./tokens.scss": {
      "sass": "./styles/_tokens.scss",
      "default": "./styles/_tokens.scss"
    }
  },
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  }
}
