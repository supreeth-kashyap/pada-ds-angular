{
  "name": "angular-design-system",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false && ng test pada-ds --watch=false",
    "build:lib": "ng build pada-ds",
    "test:lib": "ng test pada-ds --watch=false",
    "test:app": "ng test --watch=false",
    "lint": "ng lint",
    "tokens:check": "node scripts/check-tokens.mjs",
    "check": "npm run tokens:check && npm run lint && npm run test:lib && npm run test:app && npm run build:lib && ng build"
  },
  "private": true,
  "packageManager": "npm@11.11.0",
  "dependencies": {
    "@angular/cdk": "^21.2.12",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.12",
    "@angular/cli": "^21.2.12",
    "@angular/compiler-cli": "^21.2.0",
    "angular-eslint": "^21.4.0",
    "eslint": "^9.39.5",
    "jsdom": "^28.0.0",
    "ng-packagr": "~21.2.7",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.0.8"
  }
}
