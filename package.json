{
  "name": "angular-design-system",
  "version": "1.2.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false && ng test pada-ds --watch=false",
    "build:lib": "ng build pada-ds && node scripts/copy-package-docs.mjs",
    "test:lib": "ng test pada-ds --watch=false",
    "test:app": "ng test --watch=false",
    "lint": "ng lint",
    "tokens:check": "node scripts/check-tokens.mjs",
    "check": "npm run tokens:check && npm run lint && npm run test:lib && npm run test:app && npm run build:lib && ng build",
    "icons:build": "node scripts/build-icons.mjs",
    "storybook": "ng run pada-ds:storybook",
    "build-storybook": "ng run pada-ds:build-storybook",
    "chromatic": "chromatic --build-script-name build-storybook"
  },
  "private": true,
  "packageManager": "npm@11.11.0",
  "dependencies": {
    "@angular/cdk": "^21.2.12",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.25",
    "@floating-ui/dom": "^1.7.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.12",
    "@angular/animations": "^21.2.14",
    "@angular/build": "^21.2.12",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^21.2.0",
    "@angular/platform-browser-dynamic": "^21.2.14",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/angular": "^10.6.2",
    "@testing-library/angular": "^19.6.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.8",
    "angular-eslint": "^22.6.0",
    "axe-core": "^4.14.0",
    "chromatic": "^18.13.0",
    "eslint": "^9.39.5",
    "eslint-plugin-storybook": "^10.6.2",
    "jsdom": "^28.0.0",
    "ng-packagr": "~21.2.7",
    "prettier": "^3.8.1",
    "storybook": "^10.6.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.0.8"
  }
}
