{
  // For more information, visit: https://angular.dev/ai/mcp
  // Secrets are never committed: VS Code prompts for the Figma key once and stores it securely.
  "inputs": [
    {
      "type": "promptString",
      "id": "figma-api-key",
      "description": "Figma personal access token",
      "password": true
    }
  ],
  "servers": {
    "angular-cli": {
      "command": "npx",
      "args": ["-y", "@angular/cli", "mcp"]
    },
    "figma": {
      "command": "npx",
      "args": ["-y", "figma-developer-mcp", "--stdio"],
      "env": {
        "FIGMA_API_KEY": "${input:figma-api-key}"
      }
    }
  }
}
